{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node tools/arranque.mjs", "timeout": 60 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|Bash|PowerShell", "hooks": [ { "type": "command", "command": "node tools/candado.mjs", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node tools/cierre.mjs", "timeout": 120 } ] }
    ]
  }
}
