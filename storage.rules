rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Per-tenant isolation: each authenticated admin can only access their own
    // client prefix. Requires a custom JWT claim `clientId` set server-side
    // (Firebase Admin SDK setCustomUserClaims) when provisioning admin users.
    match /clients/{clientId}/{allPaths=**} {
      // Read: authenticated, tenant-scoped
      allow read: if request.auth != null
                  && request.auth.token.clientId == clientId;

      // Write: authenticated, tenant-scoped, 10 MB cap, images only
      allow write: if request.auth != null
                   && request.auth.token.clientId == clientId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }

    // Deny all paths not matched above (Storage denies by default, but explicit
    // is clearer and prevents future accidental matches)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
